<idea-plugin>
    <id>com.mikotokuroko.angelinaprogress</id>
    <name>Angelina Progress Bar</name>
    <vendor>Angelina Progress Bar</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable displayName="Angelina Progress Bar"
            dynamic="true"
            id="com.mikotokuroko.angelinaprogress.settings" instance="com.angelinaprogress.intellij.configuration.AngelinaProgressConfigurable"
            parentId="appearance" />
        <applicationService
            serviceImplementation="com.angelinaprogress.intellij.configuration.AngelinaProgressState" />
        <postStartupActivity
            implementation="com.angelinaprogress.intellij.ProjectStartupActivity" />
        <notificationGroup displayType="STICKY_BALLOON" id="Angelina Progress Bar Update" />
    </extensions>
    <applicationListeners>
        <listener class="com.angelinaprogress.intellij.AngelinaProgressListener"
            topic="com.intellij.ide.ui.LafManagerListener" />
        <listener class="com.angelinaprogress.intellij.AngelinaProgressListener"
            topic="com.intellij.ide.plugins.DynamicPluginListener" />
    </applicationListeners>
</idea-plugin>
